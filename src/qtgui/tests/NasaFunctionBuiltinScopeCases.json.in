    {
      "key": "GetLastState",
      "builtin_type": "GetLastState",
      "kind": "array",
      "oracle": "literal",
      "columns": 6,
      "tolerance": 1e-09,
      "declarations": "Create GetLastState NativeHelper;\nCreate Spacecraft Local;\nLocal.CoordinateSystem = EarthMJ2000Eq;\nLocal.DateFormat = A1ModJulian;\nLocal.Epoch = '21545';\nLocal.DisplayStateType = Cartesian;\nLocal.NAIFId = -130011;\nLocal.NAIFIdReferenceFrame = -8130011;\nLocal.X = 7100;\nLocal.Y = 20;\nLocal.Z = -30;\nLocal.VX = -0.125;\nLocal.VY = 7.25;\nLocal.VZ = 0.375;\nCreate Array State[6,1];\n",
      "execution": "[State] = NativeHelper(Local);\nout(1,1) = State(1,1);\nout(1,2) = State(2,1);\nout(1,3) = State(3,1);\nout(1,4) = State(4,1);\nout(1,5) = State(5,1);\nout(1,6) = State(6,1);\n",
