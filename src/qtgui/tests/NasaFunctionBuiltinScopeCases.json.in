{
  "schema_version": 1,
  "scope": "New main/direct/nested function-local built-in use; distinct caller/private literals and OEM endpoints, no universal or science approval.",
  "cases": [
    {
      "key": "Angle",
      "builtin_type": "Angle",
      "kind": "array",
      "oracle": "literal",
      "columns": 1,
      "tolerance": 1e-09,
      "declarations": "Create Angle NativeHelper;\nCreate Spacecraft Vertex;\nVertex.CoordinateSystem = EarthMJ2000Eq;\nVertex.DateFormat = A1ModJulian;\nVertex.Epoch = '21545';\nVertex.DisplayStateType = Cartesian;\nVertex.NAIFId = -130001;\nVertex.NAIFIdReferenceFrame = -8130001;\nVertex.X = 7000;\nVertex.Y = 0;\nVertex.Z = 0;\nVertex.VX = 0;\nVertex.VY = 7.5;\nVertex.VZ = 0;\nCreate Spacecraft EndOne;\nEndOne.CoordinateSystem = EarthMJ2000Eq;\nEndOne.DateFormat = A1ModJulian;\nEndOne.Epoch = '21545';\nEndOne.DisplayStateType = Cartesian;\nEndOne.NAIFId = -130002;\nEndOne.NAIFIdReferenceFrame = -8130002;\nEndOne.X = 7001;\nEndOne.Y = 0;\nEndOne.Z = 0;\nEndOne.VX = 0;\nEndOne.VY = 7.5;\nEndOne.VZ = 0;\nCreate Spacecraft EndTwo;\nEndTwo.CoordinateSystem = EarthMJ2000Eq;\nEndTwo.DateFormat = A1ModJulian;\nEndTwo.Epoch = '21545';\nEndTwo.DisplayStateType = Cartesian;\nEndTwo.NAIFId = -130003;\nEndTwo.NAIFIdReferenceFrame = -8130003;\nEndTwo.X = 7000;\nEndTwo.Y = 1;\nEndTwo.Z = 0;\nEndTwo.VX = 0;\nEndTwo.VY = 7.5;\nEndTwo.VZ = 0;\nCreate Variable Measured;\n",
      "execution": "[Measured] = NativeHelper(Vertex, EndOne, EndTwo);\nout(1,1) = Measured;\n",
      "main_declarations": "Create Angle CallerHelper;\nCreate Spacecraft Vertex;\nVertex.CoordinateSystem = EarthMJ2000Eq;\nVertex.DateFormat = A1ModJulian;\nVertex.Epoch = '21545';\nVertex.DisplayStateType = Cartesian;\nVertex.NAIFId = -130001;\nVertex.NAIFIdReferenceFrame = -8130001;\nVertex.X = 7000;\nVertex.Y = 0;\nVertex.Z = 0;\nVertex.VX = 0;\nVertex.VY = 7.5;\nVertex.VZ = 0;\nCreate Spacecraft EndOne;\nEndOne.CoordinateSystem = EarthMJ2000Eq;\nEndOne.DateFormat = A1ModJulian;\nEndOne.Epoch = '21545';\nEndOne.DisplayStateType = Cartesian;\nEndOne.NAIFId = -130002;\nEndOne.NAIFIdReferenceFrame = -8130002;\nEndOne.X = 7001;\nEndOne.Y = 0;\nEndOne.Z = 0;\nEndOne.VX = 0;\nEndOne.VY = 7.5;\nEndOne.VZ = 0;\nCreate Spacecraft EndTwo;\nEndTwo.CoordinateSystem = EarthMJ2000Eq;\nEndTwo.DateFormat = A1ModJulian;\nEndTwo.Epoch = '21545';\nEndTwo.DisplayStateType = Cartesian;\nEndTwo.NAIFId = -130003;\nEndTwo.NAIFIdReferenceFrame = -8130003;\nEndTwo.X = 7001;\nEndTwo.Y = 1;\nEndTwo.Z = 0;\nEndTwo.VX = 0;\nEndTwo.VY = 7.5;\nEndTwo.VZ = 0;\nCreate Variable Measured;\n",
      "main_execution": "[Measured] = CallerHelper(Vertex, EndOne, EndTwo);\nout(1,1) = Measured;\n",
      "expected": [
        90
      ],
      "main_expected": [
        45
      ],
      "caller_objects": [
        "CallerHelper",
        "Vertex",
        "EndOne",
        "EndTwo",
        "Measured"
      ],
