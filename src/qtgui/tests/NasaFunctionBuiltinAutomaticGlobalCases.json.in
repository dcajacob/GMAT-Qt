      "declarations": "Create GetEphemStates NativeHelper;\nCreate Spacecraft Local;\nLocal.CoordinateSystem = EarthMJ2000Eq;\nLocal.DateFormat = A1ModJulian;\nLocal.Epoch = '21545';\nLocal.DisplayStateType = Cartesian;\nLocal.NAIFId = -130021;\nLocal.NAIFIdReferenceFrame = -8130021;\nLocal.X = 7100;\nLocal.Y = 20;\nLocal.Z = -30;\nLocal.VX = -0.125;\nLocal.VY = 7.25;\nLocal.VZ = 0.375;\nLocal.EphemerisName = '@GMAT_BUILTIN_SCOPE_PRIVATE_OEM@';\nCreate String StartEpoch EndEpoch;\nCreate Array StartState[6,1] EndState[6,1];\n",
      "execution": "[StartEpoch, StartState, EndEpoch, EndState] = NativeHelper('CCSDS-OEM', Local, 'UTCGregorian', EarthMJ2000Eq);\nWrite StartEpoch EndEpoch {Style = Script, MessageWindow = true, LogFile = false};\nout(1,1) = strcmp(StartEpoch, '01 Jan 2018 00:00:00.000');\nout(1,14) = strcmp(EndEpoch, '01 Jan 2018 00:01:00.000');\nout(1,2) = StartState(1,1);\nout(1,8) = EndState(1,1);\nout(1,3) = StartState(2,1);\nout(1,9) = EndState(2,1);\nout(1,4) = StartState(3,1);\nout(1,10) = EndState(3,1);\nout(1,5) = StartState(4,1);\nout(1,11) = EndState(4,1);\nout(1,6) = StartState(5,1);\nout(1,12) = EndState(5,1);\nout(1,7) = StartState(6,1);\nout(1,13) = EndState(6,1);\n",
      "main_declarations": "Create GetEphemStates CallerHelper;\nCreate Spacecraft Local;\nLocal.CoordinateSystem = EarthMJ2000Eq;\nLocal.DateFormat = A1ModJulian;\nLocal.Epoch = '21545';\nLocal.DisplayStateType = Cartesian;\nLocal.NAIFId = -130021;\nLocal.NAIFIdReferenceFrame = -8130021;\nLocal.X = 7100;\nLocal.Y = 20;\nLocal.Z = -30;\nLocal.VX = -0.125;\nLocal.VY = 7.25;\nLocal.VZ = 0.375;\nLocal.EphemerisName = '@GMAT_BUILTIN_SCOPE_CALLER_OEM@';\nCreate String StartEpoch EndEpoch;\nCreate Array StartState[6,1] EndState[6,1];\n",
