+bool KeeperPrefixMatches(const std::vector<KeeperEntry> &actual,
+      const std::vector<KeeperEntry> &prefix)
+{
+   return actual.size() >= prefix.size() &&
+         std::equal(prefix.begin(), prefix.end(), actual.begin(), KeeperEntryMatches);
