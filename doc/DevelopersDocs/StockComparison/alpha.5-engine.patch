+         auto *value = dynamic_cast<FiniteThrust*>(target);
+         if (!value) throw FunctionException("Incompatible retained finite-thrust value.\n");
+         value->RebindClonedReferences(*thrust,
+               [this](GmatBase *object) {return Resolve(object);});
+      }
