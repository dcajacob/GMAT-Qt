+   std::string MatlabInvocation(const std::string &function,
+      const StringArray &inputs, const StringArray &outputs)
+   {
+      std::string command;
+      if (!outputs.empty())
+      {
+         command = "[";
+         for (size_t i = 0; i < outputs.size(); ++i)
+            command += (i ? ", " : "") + outputs[i];
+         command += "] = ";
+      }
+      command += function + "(";
+      for (size_t i = 0; i < inputs.size(); ++i)
+         command += (i ? ", " : "") + inputs[i];
+      return command + ");";
+   }
