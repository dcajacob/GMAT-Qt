diff --git a/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.cpp b/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.cpp
new file mode 100644
index 00000000..39c2af3a
--- /dev/null
+++ b/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.cpp
@@ -0,0 +1,51 @@
+#include "MatlabLibraryExecutor.hpp"
+#include "Moderator.hpp"
+#include "Interpreter.hpp"
+
+MatlabLibraryExecutor::MatlabLibraryExecutor() : caller(std::this_thread::get_id()), worker([this]{Work();}) {}
+
+MatlabLibraryExecutor::~MatlabLibraryExecutor()
+{
+   {
+      std::lock_guard<std::mutex> lock(mutex);
+      stopping = true;
+   }
+   ready.notify_one();
+   worker.join();
+}
+
+void MatlabLibraryExecutor::EnsureIdle() const
+{
+   if (OnWorker()) return;
+   if (std::this_thread::get_id() != caller)
+      throw InterfaceException("MATLAB requests must originate on the owning application thread");
+   if (active)
+      throw InterfaceException("A MATLAB evaluation is already active; a GMAT callback cannot reenter MATLAB");
+}
+
+void MatlabLibraryExecutor::ServiceUi()
+{
+   if (auto *ui = Moderator::GetUiInterpreter()) ui->SetInputFocus();
+}
+
+void MatlabLibraryExecutor::Work()
+{
+   for (;;)
+   {
+      std::function<void()> work;
+      {
+         std::unique_lock<std::mutex> lock(mutex);
+         ready.wait(lock,[this]{return stopping || bool(pending);});
+         if (stopping && !pending) return;
+         work = std::move(pending);
+         pending = {};
+      }
+      work(); // packaged_task transfers any exception to the synchronous caller.
+   }
+}
+
+MatlabLibraryExecutor &MatlabLibraries()
+{
+   static MatlabLibraryExecutor executor;
+   return executor;
+}
diff --git a/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.hpp b/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.hpp
new file mode 100644
index 00000000..8660d615
--- /dev/null
+++ b/plugins/MatlabInterfacePlugin/src/base/interface/MatlabLibraryExecutor.hpp
@@ -0,0 +1,53 @@
+#pragma once
+
+// One owner for the non-thread-safe MATLAB C libraries in the Linux Qt build.
+// The caller remains synchronous while its UI services GMAT callbacks. A callback
+// must route nested work through the callback bridge while an evaluation owns
+// MATLAB; the vendor C libraries themselves cannot be reentered.
+#include "InterfaceException.hpp"
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <type_traits>
+
+class MatlabLibraryExecutor
+{
+public:
+   MatlabLibraryExecutor();
+   ~MatlabLibraryExecutor();
+   bool OnWorker() const { return std::this_thread::get_id() == worker.get_id(); }
+   void EnsureIdle() const;
+
+   template<class F> auto Invoke(F function) -> std::invoke_result_t<F>
+   {
+      EnsureIdle();
+      using Result = std::invoke_result_t<F>;
+      auto task = std::make_shared<std::packaged_task<Result()>>(std::move(function));
+      auto future = task->get_future();
+      struct ActiveGuard { bool &flag; explicit ActiveGuard(bool &f):flag(f) {flag=true;} ~ActiveGuard(){flag=false;} } guard(active);
+      {
+         std::lock_guard<std::mutex> lock(mutex);
+         pending = [task] { (*task)(); };
+      }
+      ready.notify_one();
+      while (future.wait_for(std::chrono::milliseconds(2)) != std::future_status::ready)
+         ServiceUi();
+      return future.get();
+   }
+private:
+   void ServiceUi();
+   void Work();
+   const std::thread::id caller;
+   std::mutex mutex;
+   std::condition_variable ready;
+   std::function<void()> pending;
+   bool stopping = false;
+   bool active = false; // Accessed only by the calling/UI thread.
+   std::thread worker;
+};
+
+MatlabLibraryExecutor &MatlabLibraries();
