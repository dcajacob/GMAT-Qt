+         SpiceChar message[MAX_LONG_MESSAGE_VALUE];
+         getmsg_c("LONG", MAX_LONG_MESSAGE_VALUE, message);
+         const std::string detail = message; reset_c();
+         throw SubscriberException(std::string(operation) + ": " + detail);
+      }
