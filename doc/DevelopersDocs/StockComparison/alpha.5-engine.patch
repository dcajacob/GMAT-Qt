+            return spacecraft->GetRefObject(Gmat::FUEL_TANK, name);
+      }
+      else
+         for (FuelTank *tank : tanks)
+            if (tank && tank->GetName() == name) return tank;
+   }
+   return Hardware::GetRefObject(type, name);
+}
