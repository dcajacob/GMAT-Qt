+void Publisher::SetIntegrationStepConsumer(Subscriber *subscriber, bool enabled)
+{
+   if (!subscriber) return;
+   if (enabled) integrationStepConsumers.insert(subscriber);
+   else integrationStepConsumers.erase(subscriber);
+}
