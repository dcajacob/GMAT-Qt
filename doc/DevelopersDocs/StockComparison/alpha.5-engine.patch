+   swap(numBoundCons, other.numBoundCons);
+   swap(totalNumDecisionVars, other.totalNumDecisionVars);
+   swap(totalNumConstraints, other.totalNumConstraints);
+   swap(numElasticVars, other.numElasticVars);
