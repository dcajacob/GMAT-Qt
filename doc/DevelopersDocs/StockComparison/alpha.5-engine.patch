+         swap(lastRotDotMatrix(row, col), other.lastRotDotMatrix(row, col));
+         swap(icrfToFK5(row, col), other.icrfToFK5(row, col));
+         swap(icrfToFK5Dot(row, col), other.icrfToFK5Dot(row, col));
+      }
