+bool RestoreKeeperChildren(const std::vector<KeeperEntry> &wanted,
+      const std::vector<KeeperEntry> &prefix)
+{
+   if (wanted.empty() || !wanted.front().source.empty()) return false;
+   for (size_t index = 1; index < wanted.size(); ++index)
