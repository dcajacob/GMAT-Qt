+            for (const auto &attachedName : names)
+            {
+               GmatBase *attached = object->GetRefObject(type, attachedName);
+               if (!attached)
+                  throw CommandException("Save cannot find attachment \"" +
+                        attachedName + "\" on object \"" + name + "\"");
