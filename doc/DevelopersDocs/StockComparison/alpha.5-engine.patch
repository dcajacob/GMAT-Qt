+         values.push_back(value.get());
+         owners.push_back(std::move(value));
+      }
+   }
+   void Adopt(ObjectArray &destination)
+   {
+      for (GmatBase *object : destination) delete object;
+      destination.swap(values);
+      values.clear();
+      for (auto &owner : owners) owner.release();
+   }
+};
