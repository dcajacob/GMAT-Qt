+      return coordSystem;
+   if (type == Gmat::SPACECRAFT && (name.empty() || name == satName))
+      return spacecraft;
+   if (type == Gmat::CELESTIAL_BODY)
+   {
+      if (name == localOriginName) return localOrigin;
+      if (name == j2000BodyName) return j2000Body;
+   }
+   if (type == Gmat::FUEL_TANK || type == Gmat::HARDWARE)
