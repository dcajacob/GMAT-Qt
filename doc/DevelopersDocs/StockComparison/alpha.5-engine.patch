diff --git a/plugins/EstimationPlugin/src/base/measurement/NavigationMeasurementCopies.hpp b/plugins/EstimationPlugin/src/base/measurement/NavigationMeasurementCopies.hpp
new file mode 100644
index 00000000..3e10f9ff
