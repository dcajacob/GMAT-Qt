% Owned camera-reset presentation case; no shipped source.
Create Spacecraft Scout;
Create ForceModel Gravity;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Earth};
Create Propagator Prop;
Prop.FM = Gravity;
Prop.InitialStepSize = 5;
Prop.MaxStep = 5;
Create ReportFile Evidence;
Evidence.Filename = 'reset-state.txt';
Create OpenFramesInterface Display;
Display.Add = {Scout, Earth};
Create OpenFramesView Primary EarthView;
Display.View = {Primary, EarthView};
Primary.ViewFrame = CoordinateSystem;
Primary.SetDefaultLocation = On;
Primary.DefaultEye = [0 -30000 0];
Primary.DefaultCenter = [0 0 0];
Primary.DefaultUp = [0 0 1];
Primary.SetCurrentLocation = On;
Primary.CurrentEye = [30000 -20000 20000];
Primary.CurrentCenter = [0 0 0];
Primary.CurrentUp = [0 0 1];
EarthView.ViewFrame = Earth;
EarthView.InertialFrame = On;
EarthView.SetDefaultLocation = On;
EarthView.DefaultEye = [-30000 -30000 0];
EarthView.DefaultCenter = [0 0 0];
EarthView.DefaultUp = [0 0 1];
EarthView.SetCurrentLocation = On;
EarthView.CurrentEye = [-20000 10000 25000];
EarthView.CurrentCenter = [0 0 0];
EarthView.CurrentUp = [0 0 1];
BeginMissionSequence;
Report Evidence Scout.ElapsedSecs Scout.X Scout.Y Scout.Z;
Propagate Prop(Scout) {Scout.ElapsedSecs = 30};
Report Evidence Scout.ElapsedSecs Scout.X Scout.Y Scout.Z;
